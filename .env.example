# ========================================
# AMBIENTE DE DESENVOLVIMENTO
# ========================================
# Copie este arquivo para .env e configure os valores

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=helpdesk
DB_USER=root
DB_PASSWORD=12345

# Aplicação
APP_PORT=8080
APP_PROFILE=dev

# Spring
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SQL=DEBUG

# JWT (produção — gere com: make jwt-secret ou scripts/generate-jwt-secret.ps1)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
